# Dependencies
# package-lock.json is deliberately NOT ignored. The build is what CI runs, and
# an unpinned tree means CI compiles a different dependency graph from the one
# that was tested locally — the exact class of bug the committed build/ directory
# is meant to rule out. CI installs with `npm ci` to consume it.
node_modules/
yarn.lock

# Build files
dist/

# Temporary files
*.tmp
*.temp
*.log

# OS files
.DS_Store
Thumbs.db
*.log

# WordPress
wp-config.php
wp-content/uploads/
wp-content/backup-*
wp-content/cache/

# Languages
languages/*.mo

# NPM
npm-debug.log
yarn-error.log
.temp_files/

.wrongstack/
